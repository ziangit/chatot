# Copy to .env (git-ignored). Never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides
# CHATOT_CLAUDE_MODEL=claude-haiku-5-5
# CHATOT_TARGET_LANG=zh-Hans
# Optional alternatives (Settings → Provider). Claude is the default.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
CHATOT_PROVIDER=claude
CHATOT_OPENAI_MODEL=gpt-6-luna
CHATOT_DEEPSEEK_MODEL=deepseek-flash
