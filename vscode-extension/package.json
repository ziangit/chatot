{
  "name": "chatot-vscode",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.2.1",
  "publisher": "ziangit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ziangit/chatot"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "chatot.translateTerminalSelection",
        "title": "%translate%"
      },
      {
        "command": "chatot.translateSelection",
        "title": "%translate%"
      }
    ],
    "menus": {
      "terminal/context": [
        {
          "command": "chatot.translateTerminalSelection",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "chatot.translateSelection",
          "when": "editorHasSelection",
          "group": "navigation@1"
        }
      ]
    }
  },
  "icon": "icon.png"
}
