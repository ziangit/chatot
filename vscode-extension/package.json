{
  "name": "chatot-vscode",
  "displayName": "Chatot Translate",
  "description": "Adds 'Translate with Chatot' to the terminal and editor context menus; sends the selection to the Chatot macOS app.",
  "version": "0.2.0",
  "publisher": "ziangit",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ziangit/chatot" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      { "command": "chatot.translateTerminalSelection", "title": "Translate with Chatot" },
      { "command": "chatot.translateSelection", "title": "Translate with Chatot" }
    ],
    "menus": {
      "terminal/context": [ { "command": "chatot.translateTerminalSelection", "group": "navigation@1" } ],
      "editor/context": [ { "command": "chatot.translateSelection", "when": "editorHasSelection", "group": "navigation@1" } ]
    }
  }
}
